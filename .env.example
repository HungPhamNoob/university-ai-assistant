# ============================================
# .env.example
# Copy this file to .env and fill in your actual values.
# DO NOT commit the actual .env file to Git.
# ============================================

# --------------------------------------------
# LLM & Embedding Configuration
# --------------------------------------------
# PRIMARY provider (OpenAI-compatible gateway)
LLM_MODEL=your-primary-model
API_KEY=your-primary-api-key
BASE_URL=https://api.your-gateway.com/v1

# BACKUP provider: used automatically only when the PRIMARY key keeps
# failing with HTTP 401.
API_KEY_2=your-backup-api-key
API_KEY_2_BASE_URL=https://api.openai.com/v1
API_KEY_2_MODEL=gpt-5-nano

# Embedding / Reranker run LOCALLY (no API key needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --------------------------------------------
# Qdrant Cloud Configuration
# --------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_KB_COLLECTION=uet_hr_docs
QDRANT_CACHE_COLLECTION=uet_hr_cache
VECTOR_SIZE=384
QDRANT_TIMEOUT_SECONDS=30
QDRANT_STARTUP_RETRIES=3

# --------------------------------------------
# RAG & HyDE Configuration
# --------------------------------------------
FILE_PATH=data/UET_HR.pdf
CHUNK_SIMILARITY_THRESHOLD=0.75
HYDE_ENABLED=true
HYDE_SCORE_THRESHOLD=0.65
# "LLM_MODEL" means: reuse the primary chat model configured above.
HYDE_LLM_MODEL=LLM_MODEL

# --------------------------------------------
# External Tools
# --------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# --------------------------------------------
# Observability (LangSmith)
# --------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=UET-AI-Assistant

# --------------------------------------------
# Database (Postgres for Identity, Booking, Conversation, Agent checkpointer)
# --------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=uet_ai_db

# --------------------------------------------
# Service Ports (Local Development)
# --------------------------------------------
AGENT_PORT=8000
IDENTITY_PORT=8001
RAG_PORT=8002
BOOKING_PORT=8003
CONVERSATION_PORT=8004
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Internal service URLs (service-to-service calls)
RAG_SERVICE_URL=http://localhost:8002
BOOKING_SERVICE_URL=http://localhost:8003
CONVERSATION_SERVICE_URL=http://localhost:8004
# Agent URL used by cli.py / eval scripts (NOT service-to-service).
# - AGENT_REQUIRE_GATEWAY=true  -> keep http://localhost:8080 (Kong) and
#   /login in the CLI (Kong requires a JWT for /api/chat).
# - AGENT_REQUIRE_GATEWAY=false -> http://localhost:8000 (direct) also works.
AGENT_SERVICE_URL=http://localhost:8080

# --------------------------------------------
# Semantic Cache (RAG)
# --------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.95
# Managed Redis Cloud exact-match cache. Use rediss:// when TLS is enabled by
# the Redis Cloud database. Keep the real credential only in .env / tfvars.
REDIS_ENABLED=true
REDIS_URL=redis://default:your-redis-password@your-redis-host:your-redis-port/0
REDIS_TTL_SECONDS=300

# --------------------------------------------
# Internal Security
# --------------------------------------------
# Token for internal service-to-service communication
INTERNAL_API_TOKEN=change-this-internal-token
# JWT signing key of the Identity service (must match Kong's jwt secret)
JWT_SECRET_KEY=change-this-jwt-secret
# Shared secret proving that a request comes from the API Gateway.
# MUST match the X-Gateway-Token value injected by
# services/gateway/declarative/kong.yml (post-function plugin).
GATEWAY_SHARED_SECRET=gateway-shared-secret-change-in-prod
# Production mode for the Agent service: reject any chat/resume request that
# does not come through the gateway (X-Gateway-Token + X-User-Id required).
# - true  = mirrors production: cli.py/eval must go through Kong
#           (AGENT_SERVICE_URL=http://localhost:8080) and the CLI must /login;
#           smoke/flow tests simulate the gateway headers themselves.
# - false = direct local access to :8000 allowed (no login needed).
AGENT_REQUIRE_GATEWAY=false

# --------------------------------------------
# AWS Production Deployment (docs/aws-deployment.md)
# --------------------------------------------
# ECR registry: <account-id-without-dashes>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=005097885316.dkr.ecr.ap-southeast-1.amazonaws.com
AWS_REGION=ap-southeast-1
# Image tag pinned by configs/docker-compose.prod.yml (default: prod)
IMAGE_TAG=prod

# --------------------------------------------
# Episodic Memory (Conversation service)
# --------------------------------------------
# Memory độc lập theo thread (pattern reference C/D): mỗi cuộc trò chuyện tự
# tóm tắt tin cũ của chính nó, lưu SQL-only — KHÔNG có Qdrant episodes,
# KHÔNG inject chéo giữa các thread.
EPISODIC_ENABLED=true
# Số message tối thiểu trước khi rolling summarizer tạo summary mới.
EPISODIC_MESSAGE_THRESHOLD=20
# Timeout (giây) cho LLM call phụ của summarizer (bounded wait).
EPISODIC_LLM_TIMEOUT_SECONDS=30
EPISODIC_SUMMARIZATION_VERSION=1

# --------------------------------------------
# Context Engineering (Token Budget — Agent service)
# --------------------------------------------
TOKEN_BUDGET_SYSTEM=2048
TOKEN_BUDGET_HISTORY=3000
TOKEN_BUDGET_DOCS=20000
TOKEN_BUDGET_TOOL_OUTPUTS=5000
TOKEN_BUDGET_RESERVE=4096
CONTEXT_LIMIT=32768
