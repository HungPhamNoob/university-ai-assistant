# .dockerignore — build context hygiene.
# BuildKit chỉ gửi đúng file mà lệnh COPY tham chiếu, nhưng file này bảo vệ
# khỏi `COPY . .` trong tương lai và đảm bảo secrets không bao giờ lọt vào
# image (quan trọng khi push ECR deploy AWS).
#
# ĐỪNG exclude: pyproject.toml, uv.lock, services/ — các Dockerfile
# COPY chúng (xem grep "^COPY" services/*/Dockerfile).

# --- Secrets & sensitive (KHÔNG BAO GIỜ vào image) ---
.env
.env.*
terraform/
*.tfvars
*.tfstate
*.tfstate.*
*.pem
*.key
data/.cli_session.json

# --- VCS / CI / tools metadata ---
.git
.gitignore
.dockerignore
.github/
.gitlab-ci.yml
.claude/
.playwright-mcp/

# --- Python runtime & caches ---
.venv
__pycache__/
*.pyc
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Logs & local runtime artifacts (CLAUDE.md §3) ---
logs/
*.log
error.txt
checkpoints.db*
enterprise.db
*.db
*.db-shm
*.db-wal
*.sqlite3
ragas_real_results.csv
eval/cli_test_done.flag

# --- Folder không image nào COPY ---
tmp/
data/
docs/
configs/
scripts/
eval/
tests/
problems/
/reference/
/src/
/agent/
speech.md
practice.md
support_speech.txt
README.md
hint.md
CLAUDE.md
